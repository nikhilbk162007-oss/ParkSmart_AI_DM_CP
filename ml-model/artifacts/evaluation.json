{
  "data_source": "synthetic-demo-v1",
  "result_label": "synthetic-data demonstration; not real-world accuracy",
  "seed": 42,
  "test_fraction": 0.2,
  "features": [
    "total_capacity",
    "hour_sin",
    "hour_cos",
    "weekday_sin",
    "weekday_cos"
  ],
  "split": {
    "method": "global chronological timestamp boundary across all facilities",
    "train_samples": 670,
    "test_samples": 170,
    "train_timestamp_start": "2026-01-05T00:00:00+00:00",
    "train_timestamp_end": "2026-01-10T13:00:00+00:00",
    "test_timestamp_start": "2026-01-10T14:00:00+00:00",
    "test_timestamp_end": "2026-01-11T23:00:00+00:00"
  },
  "baseline": {
    "description": "training-set aggregate occupancy ratio multiplied by capacity",
    "raw_regression": {
      "mae": 29.823967133093323,
      "rmse": 40.38390624745964
    },
    "rounded_bounded_counts": {
      "mae": 29.68235294117647,
      "rmse": 40.26281308660708
    }
  },
  "random_forest": {
    "settings": {
      "n_estimators": 100,
      "max_depth": 8,
      "min_samples_leaf": 2,
      "random_state": 42,
      "n_jobs": 1
    },
    "raw_regression": {
      "mae": 13.750143642468643,
      "rmse": 19.91754849976332
    },
    "rounded_bounded_counts": {
      "mae": 13.735294117647058,
      "rmse": 19.9229397783501
    }
  }
}
